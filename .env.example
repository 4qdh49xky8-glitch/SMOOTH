# Copiez en .env (jamais commité). Aucun identifiant n'est nécessaire si vous vous connectez à la main
# avec `npm run login` (le profil Chromium .profile conserve la session).

# Assistant Claude (optionnel, uniquement pour réparer un sélecteur / diagnostiquer une page)
ANTHROPIC_API_KEY=

# Identifiants de l'adaptateur "example" (site démo). Un vrai adaptateur définit les siens.
EXAMPLE_EMAIL=demo@example.com
EXAMPLE_PASSWORD=demo

# Chemin d'un Chromium/Chrome précis (sinon celui de Playwright)
CHROMIUM_PATH=

# Notification supplémentaire vers votre téléphone (Slack/Discord/ntfy/webhook générique), optionnel
NOTIFY_WEBHOOK_URL=

# Niveau de logs : error | warn | info | debug (défaut : info) ; surchargé par --log-level
LOG_LEVEL=info

# Notification e-mail après CART_SUCCESS (sale:instant) — voir docs/EMAIL.md. Valeurs à renseigner dans VOTRE .env (jamais commité).
NOTIFICATION_EMAIL=
SMTP_USER=
SMTP_PASS=

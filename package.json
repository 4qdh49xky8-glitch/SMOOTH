{
  "name": "ticket-cart-agent",
  "version": "1.0.0",
  "description": "Agent de mise au panier pour billetterie en ligne (Playwright + CDP + Claude en secours). Le paiement reste manuel.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts run",
    "login": "tsx src/index.ts login",
    "check": "tsx src/index.ts check",
    "demo": "tsx scripts/demo.ts",
    "demo:server": "tsx demo/server.ts",
    "test": "node --import tsx --import ./tests/setup/noNetwork.ts --test tests/*.test.ts tests/stress/*.test.ts",
    "sites": "tsx src/index.ts sites",
    "validate": "tsx src/index.ts validate",
    "profiles": "tsx src/index.ts profiles",
    "simulate": "tsx src/index.ts simulate",
    "stats": "tsx src/index.ts stats",
    "test:fixtures": "node --import tsx --import ./tests/setup/noNetwork.ts --test tests/fixtureKit.test.ts tests/adapterContract.test.ts",
    "test:adapters": "node --import tsx --test tests/adapters.contract.test.ts",
    "new-site": "tsx scripts/new-site.ts",
    "test:stress": "node --import tsx --test tests/stress/*.test.ts",
    "platforms": "tsx src/index.ts platforms",
    "platform": "tsx src/index.ts platform",
    "doctor": "tsx src/index.ts doctor",
    "sale:check": "tsx src/index.ts sale check",
    "sale:wait": "tsx src/index.ts sale wait"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "dotenv": "^16.4.5",
    "playwright": "1.56.1",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

{
  "name": "ticket-cart-agent",
  "version": "1.0.0",
  "description": "Agent de mise au panier pour billetterie en ligne (Playwright + CDP + Claude en secours). Le paiement reste manuel.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts run",
    "login": "tsx src/index.ts login",
    "check": "tsx src/index.ts check",
    "demo": "tsx scripts/demo.ts",
    "demo:server": "tsx demo/server.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "dotenv": "^16.4.5",
    "playwright": "1.56.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
